{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafeAdSampleRecord",
  "description": "Schema definition for an individual advertisement sample record in SafeAd Dataset Hub",
  "type": "object",
  "required": [
    "sample_id",
    "file_path",
    "storage_uri",
    "media_type",
    "source_name",
    "source_url",
    "safead_label",
    "label_reason",
    "license_status",
    "sha256",
    "annotation_status",
    "review_status"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "file_path": {
      "type": "string",
      "description": "Relative workspace path to the file, e.g. SafeAd_Dataset/custom_ads/sourav/..."
    },
    "storage_uri": {
      "type": "string",
      "description": "Cloud or storage URI, e.g. gdrive://SafeAd_Dataset/..."
    },
    "media_type": {
      "type": "string",
      "enum": ["image", "video"]
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string"
    },
    "original_source_label": {
      "type": "string"
    },
    "collection_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "safead_label": {
      "type": "string",
      "enum": ["SAFE_FOR_ALL", "SAFE_14_PLUS", "SAFE_18_PLUS", "UNSAFE_FOR_ALL"]
    },
    "label_reason": {
      "type": "string",
      "minLength": 5
    },
    "license_status": {
      "type": "string",
      "minLength": 2
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "annotation_status": {
      "type": "string",
      "enum": ["COMPLETED", "IN_PROGRESS", "PENDING"]
    },
    "review_status": {
      "type": "string",
      "enum": ["PROPOSED", "ACCEPTED", "REJECTED", "NEEDS_REVIEW"]
    }
  },
  "additionalProperties": true
}
